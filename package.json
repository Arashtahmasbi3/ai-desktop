{
  "name": "ai-desktop",
  "version": "4.3.6",
  "private": true,
  "description": "AI Desktop - desktop AI assistant (DeepSeek, SSH/VPS, GitHub, local files)",
  "author": "Sepid_Com",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pretest": "node scripts/ensure-electron.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e",
    "test:watch": "vitest",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "pack": "electron-vite build && electron-builder --dir --config electron-builder.yml",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.10.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "i18next": "^25.10.10",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.52.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.6.6",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  }
}
